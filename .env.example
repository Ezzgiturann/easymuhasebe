# Bu dosyayı `.env` olarak kopyala ve değerleri yaz:
#
#   cp .env.example .env
#
# `.gitignore` `.env` dosyasını yok sayıyor, yani git'e girmez.
#
# Buradaki değerleri `supabase/config.toml` okuyor — orada `env(...)` yazan
# yerler. Yani ayar dosyası herkese açık kalırken sır dışarıda duruyor.
#
# DEĞİŞTİRDİKTEN SONRA: npx supabase stop && npx supabase start
# (Konteynerler ayarları başlarken okur; çalışan konteyner değişikliği görmez.)

# Brevo → Settings → SMTP & API → SMTP sekmesi
BREVO_SMTP_LOGIN=xxxxxxx@smtp-brevo.com
BREVO_SMTP_KEY=buraya_smtp_key_yaz
